# Copy to /usr/local/service/teddy/shared/teddy.env.
# Values in this file are loaded by start.sh, stop.sh, and upgrade.sh.
JAVA=/usr/local/jdk/bin/java
TEDDY_CONF_DIR=/usr/local/service/teddy/shared/conf
TEDDY_LOG_DIR=/usr/local/service/teddy/shared/logs
TEDDY_RUN_DIR=/usr/local/service/teddy/shared/run
TEDDY_HEALTH_URL=http://127.0.0.1:18081/system/health
TEDDY_HEALTH_TIMEOUT=60
TEDDY_STOP_TIMEOUT=30
