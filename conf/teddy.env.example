# Copy this file to the shared directory of your deployment, for example
# <deployment-root>/shared/teddy.env. Adjust every path below to your own layout.
# Values in this file are loaded by start.sh, stop.sh, and upgrade.sh.

# Java executable used to start Teddy. Use an absolute path, or `java` to rely on PATH.
JAVA=/usr/local/jdk/bin/java

# Shared directories. They must live outside the versioned release directory so
# that upgrades never move configuration, logs, runtime state or uploaded JARs.
TEDDY_CONF_DIR=/var/lib/teddy/shared/conf
TEDDY_LOG_DIR=/var/lib/teddy/shared/logs
TEDDY_RUN_DIR=/var/lib/teddy/shared/run

TEDDY_HEALTH_URL=http://127.0.0.1:18081/system/health
TEDDY_HEALTH_TIMEOUT=60
TEDDY_STOP_TIMEOUT=30
