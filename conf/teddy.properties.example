###########
# Runtime configuration
###########

# Spark installation used by SparkLauncher.
spark.home=/path/to/spark/

# Maximum wait for SparkLauncher to return an ApplicationId. The built-in
# default is 120 seconds when this setting is absent during an upgrade.
spark.submit.app-id-timeout-seconds=120

# Persistent directory containing uploaded Spark application JARs. Keep this
# outside versioned Teddy release directories so upgrades do not move uploads.
lib.home=/var/lib/teddy/jars/

# Combined stdout/stderr log written by submitted Spark processes.
log.file=/var/log/teddy/spark.log

# YARN ResourceManager HTTP endpoints, separated by commas.
yarn.cluster=rm1.example.internal:8088,rm2.example.internal:8088

# Bounded ResourceManager REST timeouts. Existing installations may omit these
# keys and use the shown built-in defaults.
yarn.http.connect-timeout-ms=3000
yarn.http.read-timeout-ms=5000

# Local YARN CLI used for manual stop and failed-submission cleanup.
yarn.command=yarn

# Maximum wait for the YARN kill command.
yarn.kill.timeout-seconds=30

# Browser-facing YARN proxy prefix used for ApplicationId links.
yarn.proxy.base-url=https://yarn-gateway.example.com/gateway/emr/yarn/proxy

# Mail settings. Leave blank when mail alerts are not used.
mail.host=
mail.port=
mail.from=
mail.passwd=

###########
# Scheduling intervals
###########

# Alert interval in seconds.
alert.interval=60

# YARN state refresh interval in seconds.
state.refresh.interval=5

# Automatic restart scan interval in seconds.
auto.restart.interval=180

# Delay the first restart scan so YARN state refresh can complete after a
# Teddy process upgrade. It should be longer than state.refresh.interval.
auto.restart.initial-delay=30

# Maximum automatic restart attempts.
auto.restart.retries=3

###########
# Authentication
###########

# Generate this value with tools/New-TeddyPasswordHash.ps1. Never store a
# plaintext password in this file.
auth.username=teddy
auth.password-hash=

# Server-side session lifetime in seconds. Sessions are invalidated when Teddy
# restarts.
auth.session.ttl-seconds=28800

# Set to true only when Teddy is served over HTTPS.
auth.cookie.secure=false
